FLASK_CONFIG=sqlite
SECRET_KEY=change-me

# Local development database. Use a PostgreSQL URL here if you prefer.
DEV_DATABASE_URI=sqlite:///db-devel.sqlite

# Production database on Opalstack.
DATABASE_URL=postgresql://user:password@localhost:5432/database

ADMIN_EMAIL=admin@example.com,info@pksk.si
EMAIL_SENDER=info@pksk.si
EMAIL_SUBJECT_PREFIX=[PKSK]

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# Relative to the project directory unless an absolute path is provided.
JSON_KEY_FILE=local_stuff/google-service-account.json

# On Opalstack, point this at a persistent directory outside code deploys.
UPLOAD_SAVE_FOLDER=
UPLOAD_FOLDER=/static/img/upload
LOG_FOLDER=
